{
  "name": "oflow",
  "version": "0.1.0",
  "description": "A small, GitLab-first workflow layer for Claude and Codex agents.",
  "type": "module",
  "bin": {
    "oflow": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PolderLabsVOF/agent-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/PolderLabsVOF/agent-workflow/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
