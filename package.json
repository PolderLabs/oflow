{
  "name": "oflow-workflow",
  "version": "0.5.2",
  "description": "A small, GitLab-first workflow layer for Claude, Codex, Copilot, and VS Code agents.",
  "type": "module",
  "bin": {
    "oflow": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:public": "node scripts/check-public-content.mjs",
    "test": "npm run check:public && npm run check:portable && npm run build && node --test test/*.test.mjs",
    "prepack": "npm run check:public && npm run build",
    "prepublishOnly": "npm run check:public && npm run build",
    "check:portable": "node scripts/check-portable.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolderLabs/oflow.git"
  },
  "bugs": {
    "url": "https://github.com/PolderLabs/oflow/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2"
  }
}
